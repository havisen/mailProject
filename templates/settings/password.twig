{% extends "layout.twig" %}

{% block content %}
  <h1>Change password</h1>
  <form method="post" action="/settings/password">
    <input type="hidden" name="_csrf" value="{{ csrf_token }}">
    <label>
      Current password
      <input type="password" name="current_password" maxlength="1024" autocomplete="current-password" required>
    </label>
    <label>
      New password
      <input type="password" name="new_password" minlength="14" maxlength="1024" autocomplete="new-password" required>
    </label>
    <label>
      Confirm new password
      <input type="password" name="new_password_confirmation" minlength="14" maxlength="1024" autocomplete="new-password" required>
    </label>
    <button type="submit">Change password</button>
  </form>
{% endblock %}
